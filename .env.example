DATABASE_URL="postgresql://crm:crm@localhost:5433/crm?schema=public"

# Auth.js / Keycloak OIDC client
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Browser-visible origin used in invitation and Keycloak action-email links.
# Railway deployments also fall back to the injected RAILWAY_PUBLIC_DOMAIN.
PUBLIC_APP_URL="http://localhost:3000"
AUTH_KEYCLOAK_ID="crm-web"
AUTH_KEYCLOAK_SECRET="replace-with-keycloak-client-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/crm"

# Separate Keycloak service-account client with user/session management permissions
AUTH_KEYCLOAK_ADMIN_CLIENT_ID="crm-admin"
AUTH_KEYCLOAK_ADMIN_CLIENT_SECRET="replace-with-admin-client-secret"

# Optional dedicated service account for one-time realm configuration. It needs
# realm-management/manage-realm. When unset, the configure script uses crm-admin.
KEYCLOAK_REALM_ADMIN_CLIENT_ID=""
KEYCLOAK_REALM_ADMIN_CLIENT_SECRET=""

# Comma-separated, case-insensitive global super-admin identities
SUPER_ADMIN_EMAILS="admin@example.com"

# Private MinIO/S3-compatible storage for organization logo uploads. MINIO_ENDPOINT
# accepts either a full URL (https://minio.example.com) or host:port (minio:9000).
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="crm"

# Optional; defaults to 86400 seconds (24 hours)
KEYCLOAK_INVITE_LIFESPAN_SECONDS="86400"

# Server-side CRM email delivery. SENDGRID_EMAIL must be a verified SendGrid sender.
# These values also power Keycloak SMTP after `npm run keycloak:email:configure`.
SENDGRID_API_KEY=""
SENDGRID_EMAIL="notifications@example.com"
# Secret used by the production scheduler. Call POST /api/calendar/reminders/dispatch
# every five minutes with Authorization: Bearer <this value>.
CALENDAR_REMINDER_CRON_SECRET="replace-with-a-long-random-secret"
# Optional. When set, SendGrid Event Webhook callbacks must be signed with this ECDSA verification key.
# When unset, signed verification is skipped and events are still accepted.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=""

# Server-side CRM AI. Never expose this as a NEXT_PUBLIC variable.
DEEPSEEK_API_KEY=""
# Optional; defaults to the quality-first current DeepSeek model.
DEEPSEEK_MODEL="deepseek-v4-pro"

# USPS shipment tracking. Credentials come from a registered application in the USPS
# Business Customer Gateway and need the "tracking" scope. When either value is missing,
# shipments are stored but never polled.
USPS_CONSUMER_KEY=""
USPS_CONSUMER_SECRET=""
# Optional; defaults to https://apis.usps.com. Point at https://apis-tem.usps.com to use the
# USPS test environment.
USPS_API_BASE_URL=""
# Secret used by the production scheduler. Call POST /api/shipments/tracking/dispatch
# every fifteen minutes with Authorization: Bearer <this value>.
SHIPMENT_TRACKING_CRON_SECRET="replace-with-a-long-random-secret"

# PO App product catalogue sync. The API token (poa_...) and the webhook signing secret
# (whsec_...) are per organization: an admin enters them in Setup -> PO App Product Sync and
# they are stored encrypted in the database. There is deliberately no environment variable for
# the token — a shared one would let an unconfigured organization sync another organization's
# store. An organization with no saved token is simply not connected.
# Default PO App API base URL, e.g. https://po.example.com/api/v1. This is a host, not a
# credential; organizations can override it in Setup.
PO_API_BASE_URL=""
# Passphrase encrypting integration secrets at rest. Keep it stable — changing it makes saved
# tokens undecryptable and they have to be entered again. Falls back to AUTH_SECRET when unset.
INTEGRATION_ENCRYPTION_KEY=""
# Secret used by the production scheduler. Call POST /api/integrations/po-app/dispatch
# every fifteen minutes with Authorization: Bearer <this value>.
PO_APP_SYNC_CRON_SECRET="replace-with-a-long-random-secret"
