DATABASE_URL="postgresql://crm:crm@localhost:5433/crm?schema=public"

# Auth.js / Keycloak OIDC client
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_KEYCLOAK_ID="crm-web"
AUTH_KEYCLOAK_SECRET="replace-with-keycloak-client-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/crm"

# Separate Keycloak service-account client with user/session management permissions
AUTH_KEYCLOAK_ADMIN_CLIENT_ID="crm-admin"
AUTH_KEYCLOAK_ADMIN_CLIENT_SECRET="replace-with-admin-client-secret"

# Comma-separated, case-insensitive global super-admin identities
SUPER_ADMIN_EMAILS="admin@example.com"

# Optional; defaults to 86400 seconds (24 hours)
KEYCLOAK_INVITE_LIFESPAN_SECONDS="86400"

# Server-side CRM email delivery. SENDGRID_EMAIL must be a verified SendGrid sender.
SENDGRID_API_KEY=""
SENDGRID_EMAIL="notifications@example.com"
# Optional. When set, SendGrid Event Webhook callbacks must be signed with this ECDSA verification key.
# When unset, signed verification is skipped and events are still accepted.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=""

# Server-side CRM AI. Never expose this as a NEXT_PUBLIC variable.
DEEPSEEK_API_KEY=""
# Optional; defaults to the quality-first current DeepSeek model.
DEEPSEEK_MODEL="deepseek-v4-pro"
