generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  status      OrganizationStatus       @default(ACTIVE)
  memberships OrganizationMembership[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

model User {
  id               String                   @id @default(cuid())
  keycloakSub      String?                  @unique
  email            String?                  @unique
  name             String
  alias            String
  avatarUrl        String?
  status           UserStatus               @default(ACTIVE)
  lastLoginAt      DateTime?
  setupEmailSentAt DateTime?
  memberships      OrganizationMembership[]
  appSessions      AppSession[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime         @default(now())
  inviteSentAt   DateTime?
  lastAccessedAt DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model AppSession {
  id                String    @id @db.Uuid
  userId            String
  keycloakSub       String
  keycloakSessionId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt])
  @@index([keycloakSessionId])
}

model Account {
  id                 String             @id @default(cuid())
  organizationId     String
  name               String
  website            String?
  type               String?
  description        String?
  parentAccountId    String?
  ownerId            String
  phone              String?
  rating             String?
  numberOfEmployees  Int?
  annualRevenue      Decimal?
  industry           String?
  billingCountry     String?
  billingStreet      String?
  billingPostalCode  String?
  billingCity        String?
  billingState       String?
  shippingCountry    String?
  shippingStreet     String?
  shippingPostalCode String?
  shippingCity       String?
  shippingState      String?
  createdById        String
  updatedById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  contacts           Contact[]
  opportunities      Opportunity[]
  cases              CaseRecord[]
  partners           Partner[]
  invoices           Invoice[]
  messagingSessions  MessagingSession[]
  videoCalls         VideoCall[]
  commerceOrders     CommerceOrder[]

  @@index([organizationId])
}

model Contact {
  id                  String                        @id @default(cuid())
  organizationId      String
  salutation          String?
  firstName           String?
  lastName            String
  accountId           String
  title               String?
  reportsToContactId  String?
  description         String?
  ownerId             String
  phone               String?
  email               String?
  birthDate           DateTime?
  leadSource          String?
  mailingCountry      String?
  mailingStreet       String?
  mailingPostalCode   String?
  mailingCity         String?
  mailingState        String?
  createdById         String
  updatedById         String
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  account             Account                       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunities       Opportunity[]
  cases               CaseRecord[]
  messagingSessions   MessagingSession[]            @relation("MessagingSessionContact")
  messageParticipants MessagingSessionParticipant[]
  videoCalls          VideoCall[]                   @relation("VideoCallContact")
  videoParticipants   VideoCallParticipant[]
  commerceOrders      CommerceOrder[]

  @@index([organizationId])
}

model Lead {
  id                       String                    @id @default(cuid())
  organizationId           String
  status                   String                    @default("New")
  salutation               String?
  firstName                String?
  lastName                 String?
  company                  String?
  title                    String?
  website                  String?
  description              String?
  ownerId                  String
  rating                   String?
  phone                    String?
  email                    String?
  country                  String?
  street                   String?
  postalCode               String?
  city                     String?
  state                    String?
  numberOfEmployees        Int?
  annualRevenue            Decimal?
  leadSource               String?
  industry                 String?
  convertedAt              DateTime?
  convertedAccountId       String?
  convertedContactId       String?
  convertedOpportunityId   String?
  createdById              String
  updatedById              String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  marketingFormSubmissions MarketingFormSubmission[]

  @@index([organizationId])
  @@index([organizationId, convertedAt])
}

model Opportunity {
  id               String      @id @default(cuid())
  organizationId   String
  name             String
  accountId        String
  contactId        String?
  closeDate        DateTime
  amount           Decimal?
  description      String?
  ownerId          String
  stage            String
  probability      Int?
  forecastCategory String
  nextStep         String?
  leadSource       String?
  courier          String?
  trackingNumber   String?
  createdById      String
  updatedById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  account          Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact          Contact?    @relation(fields: [contactId], references: [id])
  invoices         Invoice[]
  videoCalls       VideoCall[]

  @@index([organizationId])
}

model CaseRecord {
  id                             String    @id @default(cuid())
  organizationId                 String
  caseNumber                     String
  status                         String    @default("New")
  origin                         String?
  priority                       String    @default("Medium")
  ownerId                        String
  contactId                      String?
  accountId                      String?
  subject                        String?
  description                    String?
  sendNotificationEmailToContact Boolean   @default(false)
  openedAt                       DateTime  @default(now())
  closedAt                       DateTime?
  createdById                    String
  updatedById                    String
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  account                        Account?  @relation(fields: [accountId], references: [id])
  contact                        Contact?  @relation(fields: [contactId], references: [id])

  @@unique([organizationId, caseNumber])
  @@index([organizationId])
  @@map("cases")
}

model CaseNumberSequence {
  organizationId String   @id
  nextNumber     Int      @default(1)
  updatedAt      DateTime @default(now()) @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  organizationId     String
  name               String
  family             String?
  productCode        String?
  sku                String?
  category           String?
  active             Boolean             @default(false)
  description        String?
  entries            PriceBookEntry[]
  invoiceLineItems   InvoiceLineItem[]
  commerceOrderLines CommerceOrderLine[]
  inventoryItems     InventoryItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId])
}

model PriceBook {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  active         Boolean          @default(false)
  description    String?
  isStandard     Boolean          @default(false)
  validFrom      DateTime?
  validTo        DateTime?
  entries        PriceBookEntry[]
  stores         MarketingStore[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
}

model PriceBookEntry {
  id                 String              @id @default(cuid())
  organizationId     String
  productId          String
  priceBookId        String
  listPrice          Decimal?
  currency           String              @default("USD")
  active             Boolean             @default(false)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceBook          PriceBook           @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  commerceOrderLines CommerceOrderLine[]

  @@index([organizationId])
}

model Event {
  id                       String          @id @default(cuid())
  organizationId           String
  subject                  String
  description              String?
  startAt                  DateTime
  endAt                    DateTime
  attendeeIds              String[]
  nameObjectType           String?
  nameRecordId             String?
  relatedObjectType        String?
  relatedRecordId          String?
  assignedToId             String
  calendarSourceId         String?
  location                 String?
  showTimeAs               String          @default("Busy")
  allDay                   Boolean         @default(false)
  private                  Boolean         @default(false)
  recurrenceRule           String?
  recurrenceEndAt          DateTime?
  recurrenceParentId       String?
  recurrenceOriginalStart  DateTime?
  recurrenceExceptionDates DateTime[]
  reminderMinutes          Int?            @default(1440)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  calendarSource           CalendarSource? @relation(fields: [calendarSourceId], references: [id], onDelete: SetNull)
  recurrenceParent         Event?          @relation("EventRecurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  recurrenceChildren       Event[]         @relation("EventRecurrence")

  @@index([organizationId, calendarSourceId, startAt])
  @@index([organizationId, recurrenceParentId])
  @@index([organizationId, startAt])
}

model EventReminderDispatch {
  id                    String    @id @default(cuid())
  organizationId        String
  userId                String
  eventId               String
  occurrenceAt          DateTime
  status                String    @default("Legacy")
  attemptCount          Int       @default(0)
  lastAttemptAt         DateTime?
  nextAttemptAt         DateTime?
  emailAcceptedAt       DateTime?
  notificationId        String?
  warningNotificationId String?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([organizationId, userId, eventId, occurrenceAt])
  @@index([organizationId, userId])
  @@index([status, nextAttemptAt])
}

model CalendarSource {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String
  name             String
  type             String    @default("My")
  color            String    @default("#0176d3")
  visible          Boolean   @default(true)
  provider         String    @default("Local")
  externalId       String?
  connectionStatus String    @default("Local")
  readOnly         Boolean   @default(false)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  events           Event[]

  @@index([organizationId, userId])
}

model Task {
  id                String    @id @default(cuid())
  organizationId    String
  subject           String?
  dueDate           DateTime?
  status            String?
  priority          String?
  ownerId           String
  relatedObjectType String?
  relatedRecordId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model EmailActivity {
  id                String   @id @default(cuid())
  organizationId    String
  to                String
  from              String
  subject           String
  body              String?
  relatedObjectType String?
  relatedRecordId   String?
  sentAt            DateTime @default(now())
}

model EmailDelivery {
  id                String               @id @default(cuid())
  organizationId    String
  trackingKey       String
  provider          String               @default("sendgrid")
  providerMessageId String?
  sourceType        String
  sourceId          String?
  recipient         String
  sender            String
  subject           String
  status            String               @default("Accepted")
  recordedById      String
  scheduledAt       DateTime?
  acceptedAt        DateTime
  deliveredAt       DateTime?
  failedAt          DateTime?
  lastEventAt       DateTime?
  lastReason        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  events            EmailDeliveryEvent[]

  @@unique([organizationId, trackingKey, recipient])
  @@index([organizationId, sourceType, sourceId])
  @@index([trackingKey, recipient])
  @@index([providerMessageId])
}

model EmailDeliveryEvent {
  id                String        @id @default(cuid())
  organizationId    String
  deliveryId        String
  providerEventId   String?       @unique
  providerMessageId String?
  eventType         String
  occurredAt        DateTime
  reason            String?
  response          String?
  raw               Json
  createdAt         DateTime      @default(now())
  delivery          EmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([organizationId, deliveryId, occurredAt])
}

model CallActivity {
  id                String   @id @default(cuid())
  organizationId    String
  subject           String
  comments          String?
  relatedObjectType String?
  relatedRecordId   String?
  completedAt       DateTime @default(now())
}

model FileRecord {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  size              Int?
  contentType       String?
  checksum          String?
  content           Bytes?
  relatedObjectType String?
  relatedRecordId   String?
  uploadedById      String
  uploadedAt        DateTime @default(now())

  @@index([organizationId, relatedObjectType, relatedRecordId])
}

model AttachmentRecord {
  id                String   @id @default(cuid())
  organizationId    String
  name              String
  size              Int?
  contentType       String?
  checksum          String?
  content           Bytes?
  relatedObjectType String?
  relatedRecordId   String?
  uploadedById      String
  uploadedAt        DateTime @default(now())

  @@index([organizationId, relatedObjectType, relatedRecordId])
}

model QuickTextFolder {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  ownerId        String
  sharing        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  quickText      QuickText[]
}

model QuickText {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  message        String
  folderId       String?
  category       String?
  channels       String[]
  mergeFields    String[]
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  folder         QuickTextFolder?    @relation(fields: [folderId], references: [id])
  favorites      QuickTextFavorite[]
}

model QuickTextFavorite {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  quickTextId    String
  createdAt      DateTime  @default(now())
  quickText      QuickText @relation(fields: [quickTextId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, quickTextId])
  @@index([organizationId, userId, createdAt])
}

model KnowledgeArticle {
  id                   String              @id @default(cuid())
  organizationId       String
  title                String
  urlName              String
  summary              String?
  bodyRichText         String?
  visibleInInternalApp Boolean             @default(true)
  visibleToCustomer    Boolean             @default(false)
  articleNumber        String?
  publishedAt          DateTime?
  publicationStatus    String              @default("Draft")
  validationStatus     String?
  totalViewCount       Int                 @default(0)
  lastViewedAt         DateTime?
  archivedAt           DateTime?
  archivedById         String?
  createdById          String
  updatedById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  feedback             KnowledgeFeedback[]

  @@unique([organizationId, urlName])
  @@unique([organizationId, articleNumber])
}

model KnowledgeArticleNumberSequence {
  organizationId String   @id
  nextNumber     Int      @default(1)
  updatedAt      DateTime @default(now()) @updatedAt
}

model KnowledgeFeedback {
  id             String           @id @default(cuid())
  organizationId String
  articleId      String
  visitorKey     String
  helpful        Boolean
  comment        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  article        KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([organizationId, articleId, visitorKey])
  @@index([organizationId, articleId, helpful])
}

model ListEmail {
  id             String    @id @default(cuid())
  organizationId String
  layoutType     String
  subject        String?
  body           String?
  recipientType  String?
  recipients     String[]
  status         String    @default("Draft")
  sentAt         DateTime?
  scheduledAt    DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
}

model MessagingSession {
  id             String                        @id @default(cuid())
  organizationId String
  name           String
  subject        String?
  channel        String                        @default("Web Chat")
  status         String                        @default("Open")
  ownerId        String
  accountId      String?
  contactId      String?
  externalId     String?
  startedAt      DateTime                      @default(now())
  endedAt        DateTime?
  lastMessageAt  DateTime?
  createdById    String
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  account        Account?                      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact        Contact?                      @relation("MessagingSessionContact", fields: [contactId], references: [id], onDelete: SetNull)
  participants   MessagingSessionParticipant[]
  messages       MessagingMessage[]

  @@index([organizationId, status, lastMessageAt])
  @@index([organizationId, accountId])
  @@index([organizationId, contactId])
}

model MessagingSessionParticipant {
  id             String           @id @default(cuid())
  organizationId String
  sessionId      String
  contactId      String?
  name           String
  address        String?
  role           String           @default("Customer")
  joinedAt       DateTime         @default(now())
  leftAt         DateTime?
  session        MessagingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, sessionId])
  @@index([organizationId, contactId])
}

model MessagingMessage {
  id                String           @id @default(cuid())
  organizationId    String
  sessionId         String
  direction         String
  senderName        String?
  senderAddress     String?
  body              String
  status            String           @default("Recorded")
  externalMessageId String?
  recordedById      String
  sentAt            DateTime         @default(now())
  createdAt         DateTime         @default(now())
  session           MessagingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId, sentAt])
}

model Invoice {
  id                  String            @id @default(cuid())
  organizationId      String
  invoiceNumber       String
  accountId           String
  opportunityId       String?
  status              String            @default("Draft")
  issueDate           DateTime
  dueDate             DateTime
  currency            String            @default("USD")
  purchaseOrderNumber String?
  billingName         String
  billingStreet       String?
  billingCity         String?
  billingState        String?
  billingPostalCode   String?
  billingCountry      String?
  notes               String?
  terms               String?
  subtotal            Decimal           @default(0) @db.Decimal(18, 2)
  discountTotal       Decimal           @default(0) @db.Decimal(18, 2)
  taxTotal            Decimal           @default(0) @db.Decimal(18, 2)
  total               Decimal           @default(0) @db.Decimal(18, 2)
  amountPaid          Decimal           @default(0) @db.Decimal(18, 2)
  balanceDue          Decimal           @default(0) @db.Decimal(18, 2)
  createdById         String
  sentAt              DateTime?
  paidAt              DateTime?
  voidedAt            DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  opportunity         Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  lineItems           InvoiceLineItem[]
  payments            InvoicePayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, accountId])
  @@index([organizationId, opportunityId])
}

model InvoiceLineItem {
  id             String   @id @default(cuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  taxRate        Decimal  @default(0) @db.Decimal(7, 4)
  lineSubtotal   Decimal  @db.Decimal(18, 2)
  taxAmount      Decimal  @db.Decimal(18, 2)
  lineTotal      Decimal  @db.Decimal(18, 2)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId, displayOrder])
  @@index([productId])
}

model InvoicePayment {
  id              String   @id @default(cuid())
  invoiceId       String
  amount          Decimal  @db.Decimal(18, 2)
  paymentDate     DateTime
  paymentMethod   String
  referenceNumber String?
  notes           String?
  recordedById    String
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId, paymentDate])
}

model InvoiceNumberSequence {
  organizationId String   @id
  nextNumber     Int      @default(1)
  updatedAt      DateTime @default(now()) @updatedAt
}

model VideoCall {
  id               String                 @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  status           String                 @default("Scheduled")
  provider         String                 @default("External Link")
  meetingUrl       String?
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  accountId        String?
  contactId        String?
  opportunityId    String?
  organizerId      String
  createdById      String
  recordingUrl     String?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  account          Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact          Contact?               @relation("VideoCallContact", fields: [contactId], references: [id], onDelete: SetNull)
  opportunity      Opportunity?           @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  participants     VideoCallParticipant[]

  @@index([organizationId, status, scheduledStartAt])
  @@index([organizationId, accountId])
  @@index([organizationId, contactId])
  @@index([organizationId, opportunityId])
}

model VideoCallParticipant {
  id             String    @id @default(cuid())
  organizationId String
  videoCallId    String
  userId         String?
  contactId      String?
  name           String
  email          String?
  role           String    @default("Attendee")
  attendance     String    @default("Invited")
  joinedAt       DateTime?
  leftAt         DateTime?
  createdAt      DateTime  @default(now())
  videoCall      VideoCall @relation(fields: [videoCallId], references: [id], onDelete: Cascade)
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, videoCallId])
  @@index([organizationId, contactId])
}

model Partner {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  accountId      String
  role           String?
  createdAt      DateTime @default(now())
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model MarketingStore {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  slug           String
  currency       String              @default("USD")
  status         String              @default("Draft")
  description    String?
  priceBookId    String?
  createdById    String
  launchedAt     DateTime?
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  priceBook      PriceBook?          @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  orders         CommerceOrder[]
  inventoryItems InventoryItem[]
  promotions     CommercePromotion[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model CommerceOrderSequence {
  organizationId String   @id
  nextNumber     Int      @default(1)
  updatedAt      DateTime @updatedAt
}

model CommerceOrder {
  id                  String                   @id @default(cuid())
  organizationId      String
  orderNumber         String
  storeId             String
  accountId           String
  contactId           String?
  status              String                   @default("Draft")
  fulfillmentStatus   String                   @default("Unfulfilled")
  orderDate           DateTime                 @default(now())
  currency            String                   @default("USD")
  purchaseOrderNumber String?
  shippingName        String?
  shippingStreet      String?
  shippingCity        String?
  shippingState       String?
  shippingPostalCode  String?
  shippingCountry     String?
  notes               String?
  subtotal            Decimal                  @default(0) @db.Decimal(18, 2)
  discountTotal       Decimal                  @default(0) @db.Decimal(18, 2)
  taxTotal            Decimal                  @default(0) @db.Decimal(18, 2)
  shippingTotal       Decimal                  @default(0) @db.Decimal(18, 2)
  total               Decimal                  @default(0) @db.Decimal(18, 2)
  createdById         String
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  fulfilledAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  store               MarketingStore           @relation(fields: [storeId], references: [id])
  account             Account                  @relation(fields: [accountId], references: [id])
  contact             Contact?                 @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lines               CommerceOrderLine[]
  promotions          CommerceOrderPromotion[]
  fulfillments        CommerceFulfillment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status, orderDate])
  @@index([organizationId, storeId])
  @@index([organizationId, accountId])
}

model CommerceOrderLine {
  id                String                    @id @default(cuid())
  organizationId    String
  orderId           String
  productId         String
  priceBookEntryId  String?
  description       String
  quantity          Decimal                   @db.Decimal(18, 3)
  unitPrice         Decimal                   @db.Decimal(18, 2)
  discountAmount    Decimal                   @default(0) @db.Decimal(18, 2)
  taxRate           Decimal                   @default(0) @db.Decimal(7, 4)
  lineSubtotal      Decimal                   @db.Decimal(18, 2)
  taxAmount         Decimal                   @db.Decimal(18, 2)
  lineTotal         Decimal                   @db.Decimal(18, 2)
  fulfilledQuantity Decimal                   @default(0) @db.Decimal(18, 3)
  sortOrder         Int                       @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  order             CommerceOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product                   @relation(fields: [productId], references: [id])
  priceBookEntry    PriceBookEntry?           @relation(fields: [priceBookEntryId], references: [id], onDelete: SetNull)
  fulfillmentLines  CommerceFulfillmentLine[]

  @@index([organizationId, orderId])
  @@index([organizationId, productId])
}

model CommercePromotion {
  id                 String                   @id @default(cuid())
  organizationId     String
  storeId            String
  name               String
  code               String
  type               String
  value              Decimal                  @db.Decimal(18, 2)
  minimumOrderAmount Decimal?                 @db.Decimal(18, 2)
  startsAt           DateTime?
  endsAt             DateTime?
  maxRedemptions     Int?
  redemptionCount    Int                      @default(0)
  active             Boolean                  @default(true)
  createdById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  store              MarketingStore           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders             CommerceOrderPromotion[]

  @@unique([organizationId, storeId, code])
  @@index([organizationId, storeId, active])
}

model CommerceOrderPromotion {
  id             String            @id @default(cuid())
  organizationId String
  orderId        String
  promotionId    String
  discountAmount Decimal           @db.Decimal(18, 2)
  createdAt      DateTime          @default(now())
  order          CommerceOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion      CommercePromotion @relation(fields: [promotionId], references: [id])

  @@unique([organizationId, orderId, promotionId])
  @@index([organizationId, orderId])
}

model InventoryItem {
  id               String         @id @default(cuid())
  organizationId   String
  storeId          String
  productId        String
  quantityOnHand   Decimal        @default(0) @db.Decimal(18, 3)
  quantityReserved Decimal        @default(0) @db.Decimal(18, 3)
  reorderPoint     Decimal        @default(0) @db.Decimal(18, 3)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  store            MarketingStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, storeId, productId])
  @@index([organizationId, storeId])
}

model CommerceFulfillment {
  id                String                    @id @default(cuid())
  organizationId    String
  orderId           String
  fulfillmentNumber String
  status            String                    @default("Draft")
  carrier           String?
  trackingNumber    String?
  notes             String?
  createdById       String
  packedAt          DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  order             CommerceOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines             CommerceFulfillmentLine[]

  @@unique([organizationId, fulfillmentNumber])
  @@index([organizationId, orderId])
}

model CommerceFulfillmentLine {
  id             String              @id @default(cuid())
  organizationId String
  fulfillmentId  String
  orderLineId    String
  quantity       Decimal             @db.Decimal(18, 3)
  createdAt      DateTime            @default(now())
  fulfillment    CommerceFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderLine      CommerceOrderLine   @relation(fields: [orderLineId], references: [id])

  @@unique([organizationId, fulfillmentId, orderLineId])
  @@index([organizationId, orderLineId])
}

model CustomReport {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  object         String
  groupField     String
  columns        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model CustomDashboard {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  reportIds      Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Campaign {
  id               String                 @id @default(cuid())
  organizationId   String
  name             String
  status           String                 @default("Planned")
  type             String                 @default("Email")
  ownerId          String
  parentCampaignId String?
  startDate        DateTime?
  endDate          DateTime?
  budgetedCost     Decimal?               @db.Decimal(18, 2)
  actualCost       Decimal?               @db.Decimal(18, 2)
  expectedRevenue  Decimal?               @db.Decimal(18, 2)
  description      String?
  createdById      String
  activatedAt      DateTime?
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  parentCampaign   Campaign?              @relation("CampaignHierarchy", fields: [parentCampaignId], references: [id], onDelete: SetNull)
  childCampaigns   Campaign[]             @relation("CampaignHierarchy")
  members          CampaignMember[]
  landingPages     MarketingLandingPage[]

  @@unique([organizationId, name])
  @@index([organizationId, status, startDate])
  @@index([organizationId, parentCampaignId])
}

model CampaignMember {
  id               String    @id @default(cuid())
  organizationId   String
  campaignId       String
  objectType       String
  recordId         String
  status           String    @default("Sent")
  responded        Boolean   @default(false)
  firstRespondedAt DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([organizationId, campaignId, objectType, recordId])
}

model RecordLabel {
  id             String   @id @default(cuid())
  organizationId String
  objectType     String
  recordId       String
  label          String
  color          String?
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([organizationId, objectType, recordId, label])
}

model MarketingActivation {
  id             String   @id @default(cuid())
  organizationId String
  senderName     String
  senderEmail    String
  tracking       Boolean  @default(true)
  active         Boolean  @default(true)
  activatedById  String
  activatedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MarketingLandingPage {
  id             String                    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         String                    @default("Draft")
  headline       String
  description    String?
  submitLabel    String                    @default("Submit")
  successMessage String                    @default("Thanks. Your information was received.")
  fields         String[]
  campaignId     String?
  ownerId        String
  createdById    String
  publishedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  campaign       Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  submissions    MarketingFormSubmission[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, campaignId])
}

model MarketingFormSubmission {
  id             String               @id @default(cuid())
  organizationId String
  landingPageId  String
  leadId         String?
  data           Json
  submittedAt    DateTime             @default(now())
  landingPage    MarketingLandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  lead           Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, landingPageId, submittedAt])
  @@index([organizationId, leadId])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  body           String
  href           String?
  category       String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NotificationPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  category       String
  enabled        Boolean  @default(true)
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, userId, category])
}

model GuidanceItem {
  id        String              @id
  title     String
  body      String
  href      String?
  target    String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt
  states    UserGuidanceState[]
}

model UserGuidanceState {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  itemId         String
  status         String       @default("ACTIVE")
  snoozedUntil   DateTime?
  updatedAt      DateTime     @default(now()) @updatedAt
  item           GuidanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, itemId])
}

model UserPreference {
  id                 String   @id @default(cuid())
  organizationId     String
  userId             String
  displayDensity     String   @default("Comfy")
  guidanceEnabled    Boolean  @default(true)
  consoleTabsEnabled Boolean  @default(true)
  homeMode           String   @default("Onboarding")
  quarterlyGoal      Decimal?
  timezone           String?
  locale             String?
  weekStartsOn       Int      @default(0)
  updatedAt          DateTime @default(now()) @updatedAt

  @@unique([organizationId, userId])
}

model SetupShortcutState {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  shortcutId     String
  pinned         Boolean   @default(false)
  lastOpenedAt   DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([organizationId, userId, shortcutId])
}

model HelpArticleState {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  articleId      String
  saved          Boolean   @default(false)
  helpful        Boolean?
  viewedAt       DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([organizationId, userId, articleId])
}

model AppNavPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  app            String
  items          Json
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, userId, app])
}

model ListViewPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  object         String
  viewName       String
  columns        Json
  columnWidths   Json?
  filters        Json?
  chartType      String?
  chartField     String?
  sharing        String?  @default("Only I can see this list view")
  pinned         Boolean  @default(false)
  isCustom       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, userId, object, viewName])
}

model GlobalSearchRecent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  query          String?
  label          String
  context        String
  href           String
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, userId, href])
}

model AgentforceMessage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String
  text           String
  metadata       Json?
  createdAt      DateTime @default(now())
}

model AiInsightCache {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  surface        String
  scopeKey       String
  sourceHash     String
  payload        Json
  model          String
  usage          Json?
  generatedAt    DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, userId, surface, scopeKey])
  @@index([organizationId, userId, surface])
}

model ShipmentTracking {
  id                      String    @id @default(cuid())
  organizationId          String
  subjectType             String
  subjectId               String
  carrier                 String
  trackingNumber          String
  status                  String    @default("Pending")
  statusSummary           String?
  expectedDeliveryAt      DateTime?
  lastEventAt             DateTime?
  lastEventDescription    String?
  deliveredAt             DateTime?
  deliveredNotificationId String?
  alertNotificationId     String?
  attemptCount            Int       @default(0)
  failureCount            Int       @default(0)
  lastPolledAt            DateTime?
  nextPollAt              DateTime?
  lastError               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([organizationId, subjectType, subjectId])
  @@index([carrier, status, nextPollAt])
  @@index([organizationId, subjectType, subjectId])
}
