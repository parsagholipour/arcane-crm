generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  alias     String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id                    String       @id @default(cuid())
  name                  String
  website               String?
  type                  String?
  description           String?
  parentAccountId       String?
  ownerId               String
  phone                 String?
  billingCountry        String?
  billingStreet         String?
  billingPostalCode     String?
  billingCity           String?
  billingState          String?
  shippingCountry       String?
  shippingStreet        String?
  shippingPostalCode    String?
  shippingCity          String?
  shippingState         String?
  createdById           String
  updatedById           String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  contacts              Contact[]
  opportunities         Opportunity[]
  cases                 CaseRecord[]
  partners              Partner[]
}

model Contact {
  id                 String       @id @default(cuid())
  salutation         String?
  firstName          String?
  lastName           String
  accountId          String
  title              String?
  reportsToContactId String?
  description        String?
  ownerId            String
  phone              String?
  email              String?
  mailingCountry     String?
  mailingStreet      String?
  mailingPostalCode  String?
  mailingCity        String?
  mailingState       String?
  createdById        String
  updatedById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  account            Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]
  cases              CaseRecord[]
}

model Lead {
  id                String   @id @default(cuid())
  status            String   @default("New")
  salutation        String?
  firstName         String?
  lastName          String
  company           String
  title             String?
  website           String?
  description       String?
  ownerId           String
  rating            String?
  phone             String?
  email             String?
  country           String?
  street            String?
  postalCode        String?
  city              String?
  state             String?
  numberOfEmployees Int?
  annualRevenue     Decimal?
  leadSource        String?
  industry          String?
  createdById       String
  updatedById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Opportunity {
  id               String    @id @default(cuid())
  name             String
  accountId        String
  contactId        String?
  closeDate        DateTime
  amount           Decimal?
  description      String?
  ownerId          String
  stage            String
  probability      Int?
  forecastCategory String
  nextStep         String?
  createdById      String
  updatedById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact          Contact?  @relation(fields: [contactId], references: [id])
}

model CaseRecord {
  id                             String   @id @default(cuid())
  caseNumber                     String   @unique
  status                         String   @default("New")
  origin                         String?
  priority                       String   @default("Medium")
  ownerId                        String
  contactId                      String?
  accountId                      String?
  subject                        String?
  description                    String?
  sendNotificationEmailToContact Boolean  @default(false)
  openedAt                       DateTime @default(now())
  closedAt                       DateTime?
  createdById                    String
  updatedById                    String
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  account                        Account? @relation(fields: [accountId], references: [id])
  contact                        Contact? @relation(fields: [contactId], references: [id])

  @@map("cases")
}

model Product {
  id          String           @id @default(cuid())
  name        String
  family      String?
  productCode String?
  sku         String?
  active      Boolean          @default(false)
  description String?
  entries     PriceBookEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PriceBook {
  id          String           @id @default(cuid())
  name        String
  active      Boolean          @default(false)
  description String?
  isStandard  Boolean          @default(false)
  validFrom   DateTime?
  validTo     DateTime?
  entries     PriceBookEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PriceBookEntry {
  id          String    @id @default(cuid())
  productId   String
  priceBookId String
  listPrice   Decimal?
  currency    String    @default("USD")
  active      Boolean   @default(false)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
}

model Event {
  id                  String   @id @default(cuid())
  subject             String
  description         String?
  startAt             DateTime
  endAt               DateTime
  attendeeIds         String[]
  nameObjectType      String?
  nameRecordId        String?
  relatedObjectType   String?
  relatedRecordId     String?
  assignedToId        String
  location            String?
  showTimeAs          String   @default("Busy")
  allDay              Boolean  @default(false)
  private             Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CalendarSource {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("My")
  color     String   @default("#0176d3")
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Task {
  id                String    @id @default(cuid())
  subject           String?
  dueDate           DateTime?
  status            String?
  priority          String?
  ownerId           String
  relatedObjectType String?
  relatedRecordId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model EmailActivity {
  id                String    @id @default(cuid())
  to                String
  from              String
  subject           String
  body              String?
  relatedObjectType String?
  relatedRecordId   String?
  sentAt            DateTime  @default(now())
}

model CallActivity {
  id                String   @id @default(cuid())
  subject           String
  comments          String?
  relatedObjectType String?
  relatedRecordId   String?
  completedAt       DateTime @default(now())
}

model FileRecord {
  id                String   @id @default(cuid())
  name              String
  size              Int?
  relatedObjectType String?
  relatedRecordId   String?
  uploadedById      String
  uploadedAt        DateTime @default(now())
}

model AttachmentRecord {
  id                String   @id @default(cuid())
  name              String
  size              Int?
  relatedObjectType String?
  relatedRecordId   String?
  uploadedById      String
  uploadedAt        DateTime @default(now())
}

model QuickTextFolder {
  id        String      @id @default(cuid())
  name      String
  ownerId   String
  sharing   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  quickText QuickText[]
}

model QuickText {
  id          String           @id @default(cuid())
  name        String
  message     String
  folderId    String?
  category    String?
  channels    String[]
  mergeFields String[]
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  folder      QuickTextFolder? @relation(fields: [folderId], references: [id])
}

model KnowledgeArticle {
  id                   String    @id @default(cuid())
  title                String
  urlName              String
  summary              String?
  bodyRichText         String?
  visibleInInternalApp Boolean   @default(true)
  visibleToCustomer    Boolean   @default(false)
  articleNumber        String?
  publishedAt          DateTime?
  publicationStatus    String    @default("Draft")
  validationStatus     String?
  totalViewCount       Int       @default(0)
  archivedAt           DateTime?
  archivedById         String?
  createdById          String
  updatedById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ListEmail {
  id            String   @id @default(cuid())
  layoutType    String
  subject       String?
  body          String?
  recipientType String?
  recipients    String[]
  status        String   @default("Draft")
  sentAt        DateTime?
  scheduledAt   DateTime?
  createdById   String
  createdAt     DateTime @default(now())
}

model MessagingSession {
  id        String   @id @default(cuid())
  name      String?
  status    String?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id        String   @id @default(cuid())
  name      String?
  status    String?
  amount    Decimal?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoCall {
  id        String   @id @default(cuid())
  name      String?
  provider  String?
  startedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  accountId String
  role      String?
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model MarketingStore {
  id        String   @id @default(cuid())
  name      String
  currency  String?
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomReport {
  id         String   @id @default(cuid())
  userId     String
  name       String
  object     String
  groupField String
  columns    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model CustomDashboard {
  id        String   @id @default(cuid())
  userId    String
  name      String
  reportIds Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Campaign {
  id        String           @id @default(cuid())
  name      String           @unique
  status    String           @default("Planned")
  ownerId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  members   CampaignMember[]
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  objectType String
  recordId   String
  status     String   @default("Sent")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, objectType, recordId])
}

model RecordLabel {
  id         String   @id @default(cuid())
  objectType String
  recordId   String
  label      String
  color      String?
  createdById String
  createdAt  DateTime @default(now())

  @@unique([objectType, recordId, label])
}

model MarketingActivation {
  id          String   @id @default(cuid())
  senderName  String
  senderEmail String
  tracking    Boolean  @default(true)
  active      Boolean  @default(true)
  activatedById String
  activatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubscriptionCheckout {
  id        String   @id @default(cuid())
  plan      String
  seats     Int
  code      String?
  status    String   @default("Prepared")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  category  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, category])
}

model GuidanceItem {
  id        String              @id
  title     String
  body      String
  href      String?
  target    String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt
  states    UserGuidanceState[]
}

model UserGuidanceState {
  id           String       @id @default(cuid())
  userId       String
  itemId       String
  status       String       @default("ACTIVE")
  snoozedUntil DateTime?
  updatedAt    DateTime     @default(now()) @updatedAt
  item         GuidanceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  displayDensity     String   @default("Comfy")
  guidanceEnabled    Boolean  @default(true)
  consoleTabsEnabled Boolean  @default(true)
  homeMode           String   @default("Onboarding")
  quarterlyGoal      Decimal?
  timezone           String?
  locale             String?
  updatedAt          DateTime @default(now()) @updatedAt
}

model SetupShortcutState {
  id           String    @id @default(cuid())
  userId       String
  shortcutId   String
  pinned       Boolean   @default(false)
  lastOpenedAt DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([userId, shortcutId])
}

model HelpArticleState {
  id        String    @id @default(cuid())
  userId    String
  articleId String
  saved     Boolean   @default(false)
  helpful   Boolean?
  viewedAt  DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([userId, articleId])
}

model AppNavPreference {
  id        String   @id @default(cuid())
  userId    String
  app       String
  items     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, app])
}

model ListViewPreference {
  id        String   @id @default(cuid())
  userId    String
  object    String
  viewName  String
  columns   Json
  columnWidths Json?
  filters   Json?
  chartType String?
  chartField String?
  pinned    Boolean  @default(false)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, object, viewName])
}

model GlobalSearchRecent {
  id        String   @id @default(cuid())
  userId    String
  query     String?
  label     String
  context   String
  href      String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, href])
}

model AgentforceMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  text      String
  metadata  Json?
  createdAt DateTime @default(now())
}
