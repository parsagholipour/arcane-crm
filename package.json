{
  "name": "reloriq-crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:files": "node scripts/check-file-size.mjs",
    "test:unit": "tsx --conditions=react-server --test src/lib/*.test.ts src/lib/ai/*.test.ts src/lib/api/*.test.ts src/lib/email/*.test.ts src/lib/query/*.test.ts src/features/**/*.test.ts && node --test scripts/configure-keycloak-email.test.mjs",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:component && npm run check:files",
    "test:usecases": "node scripts/crm-usecase-check.mjs",
    "test:invoice": "tsx --test src/lib/invoice-calculations.test.ts",
    "test:email": "tsx --conditions=react-server --test src/lib/email/*.test.ts",
    "test:user-management": "tsx --conditions=react-server --test src/lib/organization-invitations.test.ts src/lib/organization-context.test.ts",
    "test:keycloak-email": "node --test scripts/configure-keycloak-email.test.mjs",
    "test:files": "tsx --test src/lib/files.test.ts",
    "test:calendar": "tsx --conditions=react-server --test src/lib/calendar.test.ts src/lib/calendar-recurrence.test.ts src/lib/calendar-reminder-values.test.ts src/lib/calendar-reminders.test.ts",
    "test:ai": "tsx --conditions=react-server --test src/lib/ai/*.test.ts",
    "lint": "eslint . --max-warnings 0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "keycloak:email:configure": "node scripts/configure-keycloak-email.mjs",
    "keycloak:email:check": "node scripts/configure-keycloak-email.mjs --check",
    "test:lead-conversion": "tsx --test src/lib/lead-conversion.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.11.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
